# ===================================================================
# Healthcare Appointment Management System - Environment Variables Template
# Copy this file or set these variables in your deployment environment (e.g. Railway / Vercel).
# NEVER commit real credentials, passwords, or production secrets to Git.
# ===================================================================

# Server Port (Railway will set PORT automatically)
PORT=8080

# Database Configuration (Railway PostgreSQL or Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_db
DB_USERNAME=postgres
DB_PASSWORD=

# JWT Authentication Configuration
# Generate a secure 256-bit Base64-encoded string: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_base64_encoded
JWT_EXPIRATION=86400000

# CORS Configuration
# Allowed Frontend Origins (Comma-separated for multiple, e.g. Vercel domain and localhost)
FRONTEND_URL=https://your-frontend.vercel.app

# AI / Chatbot Configuration (Optional - Falls back to local assistant if not provided)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# WhatsApp Business Cloud API Configuration (Optional - In-app PDF download works without this)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Scheduler Configuration (Optional customization)
FOLLOWUP_REMINDER_DAYS_BEFORE=1
FOLLOWUP_REMINDER_RATE=86400000
FOLLOWUP_REMINDER_INITIAL_DELAY=10000
APPOINTMENT_EXPIRY_RATE=3600000
APPOINTMENT_EXPIRY_INITIAL_DELAY=5000
APPOINTMENT_REMINDER_RATE=60000
APPOINTMENT_REMINDER_INITIAL_DELAY=5000
WAITLIST_EXPIRY_RATE=60000
WAITLIST_EXPIRY_INITIAL_DELAY=10000
